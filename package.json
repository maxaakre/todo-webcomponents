{
  "name": "webcomponents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter daily-todo dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter daily-todo preview",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter daily-todo test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "storybook": "pnpm --filter @maxaakre/ui storybook",
    "changeset": "changeset",
    "deploy:storybook": "pnpm --filter @maxaakre/ui build-storybook --quiet && npx -y vercel@latest deploy packages/ui/storybook-static --project maxaakre-ui --prod --yes && SMOKE_URL=https://maxaakre-ui.vercel.app pnpm --filter @maxaakre/ui smoke-storybook"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rs-module-lexer"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/browser-playwright": "5.0.1"
  }
}
