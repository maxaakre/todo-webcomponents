{
  "name": "@maxaakre/ui",
  "version": "0.0.0",
  "description": "A small, deep Lit component library: accessible, typed, themeable.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/**/ui-*.js",
    "./src/**/ui-*.ts",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/ui-button.d.ts",
      "default": "./dist/button/ui-button.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.js && pnpm manifest",
    "manifest": "cem analyze --litelement --globs 'src/**/ui-*.ts' --exclude 'src/**/*.test.ts' --exclude 'src/**/*.stories.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "smoke-storybook": "node scripts/smoke-storybook.js"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@vitest/browser-playwright": "5.0.1",
    "axe-core": "^4.13.0",
    "lit": "^3.3.3",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
